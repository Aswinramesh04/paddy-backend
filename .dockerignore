# Ignore local virtualenvs and Python cache
.venv/
venv/
env/
__pycache__/
*.py[cod]

# Git and CI
.git
.gitignore

# Local env files / secrets
.env
.env.*
secrets.yml

# Logs and uploads (avoid copying large runtime files into image)
logs/
uploads/
*.log

# Build / packaging
build/
dist/
*.egg-info/

# Editor directories
.vscode/
.idea/
.DS_Store

# Tests
tests/

# If you want to include your model in the Docker image, remove 'model' from here
# model/

# Keep Docker build context small; do NOT ignore the application source or Dockerfile.
# (Ensure `Dockerfile`, `app/`, and `requirements.txt` are present in the build context.)
.venv